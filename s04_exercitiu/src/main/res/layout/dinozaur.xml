<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adauga un dinozaur nou!"
        />

    <EditText
        android:id="@+id/etNume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/exemplu_t_rex"
        />

    <CheckBox
        android:id="@+id/cbCarnivor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/este_carnivor"

        />

    <RadioGroup
        android:id="@+id/rgHabitat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbTerestru"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terestru"
            android:checked="true"
            />
        <RadioButton
            android:id="@+id/rbAcvatic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/acvatic"
            />
        <RadioButton
            android:id="@+id/rbAerian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aerian"
            />
        </RadioGroup>


    <Spinner
        android:id="@+id/spPerioada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/perioade_dinozauri"
        />

    <RatingBar
        android:id="@+id/rbPericol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <Switch
        android:id="@+id/swDescoperitRecent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/a_fost_descoperit_recent"
        />

    <Button
        android:id="@+id/btnAdauga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adauga"
        />

</LinearLayout>